# Copy to .env and fill in to email AI plan prompts. Leave WORKOUT_SMTP_HOST empty to disable email.

# Where you open the app (used for the link in emails), e.g. the Pi's address.
WORKOUT_APP_URL=http://raspberrypi.local:8080

# Gmail example: use an app password, not your normal password.
WORKOUT_SMTP_HOST=smtp.gmail.com
WORKOUT_SMTP_PORT=587
WORKOUT_SMTP_SECURITY=starttls
WORKOUT_SMTP_USERNAME=your.address@gmail.com
WORKOUT_SMTP_PASSWORD=
WORKOUT_SMTP_FROM=
